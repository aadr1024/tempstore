#!/bin/bash
# tempstore - quick snippet storage with fzf
# Usage: tempstore <text>  - save
#        tempstore         - pick & copy (ctrl-d to delete)

STORE_DIR="${TEMPSTORE_DIR:-$HOME/.tempstore}"
MAX_SIZE_KB=100  # warn if file exceeds this

mkdir -p "$STORE_DIR"

# Convert file timestamp to relative time
relative_time() {
    local file="$1"
    local now=$(date +%s)
    local file_time=$(stat -f %m "$file" 2>/dev/null || stat -c %Y "$file" 2>/dev/null)
    local diff=$((now - file_time))

    if (( diff < 60 )); then echo "${diff}s ago"
    elif (( diff < 3600 )); then echo "$((diff / 60))m ago"
    elif (( diff < 86400 )); then echo "$((diff / 3600))h ago"
    elif (( diff < 604800 )); then echo "$((diff / 86400))d ago"
    else echo "$((diff / 604800))w ago"
    fi
}

# Save mode
if [[ $# -gt 0 ]]; then
    file="$STORE_DIR/$(date +%Y%m%d_%H%M%S)"
    echo "$*" > "$file"
    size=$(du -k "$file" | cut -f1)
    if (( size > MAX_SIZE_KB )); then
        echo "Warning: stored ${size}KB (exceeds ${MAX_SIZE_KB}KB limit)"
        read -p "Keep anyway? [y/N] " -n 1 -r
        echo
        [[ ! $REPLY =~ ^[Yy]$ ]] && rm "$file" && echo "Deleted." && exit 1
    fi
    echo "Saved (${size}KB)"
    exit 0
fi

# Retrieve mode - check for large files first
large_files=$(find "$STORE_DIR" -type f -size +${MAX_SIZE_KB}k 2>/dev/null)
if [[ -n "$large_files" ]]; then
    count=$(echo "$large_files" | wc -l | tr -d ' ')
    echo "Found $count large file(s) (>${MAX_SIZE_KB}KB). Opening cleanup view..."
    echo

    # Show large files in fzf with multi-select for deletion
    to_delete=$(echo "$large_files" | while read f; do
        size=$(du -h "$f" | cut -f1)
        echo "$size|$f"
    done | fzf --multi \
        --preview "cat {2}" \
        --preview-window=up:5:wrap \
        --header="TAB=select  Enter=delete selected  Esc=skip" \
        --delimiter='|' \
        --with-nth=1,2 \
        | cut -d'|' -f2)

    if [[ -n "$to_delete" ]]; then
        echo "$to_delete" | xargs rm
        echo "Deleted $(echo "$to_delete" | wc -l | tr -d ' ') file(s)."
    fi
fi

# Check if store is empty
if [[ -z "$(ls -A "$STORE_DIR" 2>/dev/null)" ]]; then
    echo "No stored items. Use: tempstore <text>"
    exit 0
fi

# Build list with relative times
build_list() {
    for f in $(ls -t "$STORE_DIR"); do
        local time=$(relative_time "$STORE_DIR/$f")
        local preview=$(head -c 60 "$STORE_DIR/$f" | tr '\n' ' ')
        printf "%-8s %s|%s\n" "$time" "$preview" "$f"
    done
}

# fzf picker - sorted by most recent (first item focused), ctrl-d to delete
selected=$(build_list | fzf \
    --no-sort \
    --preview "cat '$STORE_DIR/{-1}'" \
    --preview-window=up:5:wrap \
    --header="Enter=copy  ctrl-d=delete" \
    --delimiter='\|' \
    --with-nth=1 \
    --bind="ctrl-d:execute(rm '$STORE_DIR/{-1}')+reload(for f in \$(ls -t '$STORE_DIR'); do t=\$(stat -f %m '$STORE_DIR/'\$f); now=\$(date +%s); d=\$((now-t)); if (( d<60 )); then p=\"\${d}s ago\"; elif (( d<3600 )); then p=\"\$((d/60))m ago\"; elif (( d<86400 )); then p=\"\$((d/3600))h ago\"; else p=\"\$((d/86400))d ago\"; fi; preview=\$(head -c 60 '$STORE_DIR/'\$f | tr '\n' ' '); printf '%-8s %s|%s\n' \"\$p\" \"\$preview\" \$f; done)" \
    | cut -d'|' -f2)

if [[ -n "$selected" && -f "$STORE_DIR/$selected" ]]; then
    cat "$STORE_DIR/$selected" | pbcopy
    echo "Copied!"
fi
